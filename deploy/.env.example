# Database password: letters and digits only (it is used inside connection URLs)
DB_PASSWORD=changeme123

# Port of the app on the NAS → http://<nas>:8085
PORT=8085

# Where the database and the backup files live on the NAS
APPDATA=/mnt/user/appdata/stockqr

# Backup copy in a Supabase project (leave empty to keep only the local backup files).
# On first start, an empty local database is filled from this project.
BACKUP_SUPABASE_URL=https://your-project-ref.supabase.co
BACKUP_SUPABASE_KEY=sb_publishable_...

# Backup every N hours, keep the last N backup files
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=30
